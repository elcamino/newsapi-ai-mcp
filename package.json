{
  "name": "newsapi-ai-mcp",
  "version": "0.1.0",
  "description": "MCP server for newsapi.ai (Event Registry): search news articles and events from any MCP client",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node test/run.mjs"
  },
  "keywords": [
    "mcp",
    "newsapi.ai",
    "eventregistry",
    "news",
    "model-context-protocol",
    "claude",
    "codex",
    "opencode"
  ],
  "author": "Tobias von Dewitz",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "newsapi-ai-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
