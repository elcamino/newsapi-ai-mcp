{
  "name": "newsapi-ai-mcp",
  "version": "0.2.0",
  "description": "MCP server for newsapi.ai (Event Registry): search news articles and events from any MCP client",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node test/run.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "newsapi.ai",
    "eventregistry",
    "news",
    "model-context-protocol",
    "claude",
    "codex",
    "opencode"
  ],
  "author": "Tobias von Dewitz",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "newsapi-ai-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcamino/newsapi-ai-mcp.git"
  },
  "homepage": "https://github.com/elcamino/newsapi-ai-mcp#readme",
  "bugs": {
    "url": "https://github.com/elcamino/newsapi-ai-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
